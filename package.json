{
  "name": "triggerbot",
  "version": "1.0.0",
  "description": "Bot privado para la comunidad Trigger — alojado en Wispbyte",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "register": "node src/deploy-commands.js",
    "db:test": "node scripts/db-test.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.8"
  }
}
