[TEMPLATE]
[TEMPLATE]
# Copia este archivo como ".env" y completa los valores.
# En Wispbyte: pestaña Startup -> Variables, o sube el .env (NUNCA lo subas a GitHub).

DISCORD_TOKEN=pegar_aqui_el_token_del_bot
CLIENT_ID=pegar_aqui_el_id_de_la_aplicacion
GUILD_ID=pegar_aqui_el_id_de_tu_servidor

# Presupuesto diario de IA (opcional; por defecto 300 respuestas por día).
# Cuando se agota, el bot deja de llamar al modelo hasta la medianoche (hora de
# Argentina) y contesta con su repertorio local; el staff recibe un aviso. Es la
# protección contra una ráfaga de menciones que se coma la cuota gratuita del día.
IA_LIMITE_DIARIO=300

# Opcional: chat con IA al mencionar al bot. Alcanza UNA clave; cada una de más suma
# respaldo. El bot usa los proveedores con clave en este orden y saltea los que se caen
# (si Groq agota su cuota, el mensaje siguiente sale por el que siga, sin que el
# usuario espere). Sin ninguna clave el bot igual funciona: responde con su repertorio
# local de charla.
# Groq (principal): clave gratis en https://console.groq.com/keys
# Cerebras:        clave gratis en https://cloud.cerebras.ai
# Gemini:          clave gratis en https://aistudio.google.com/apikey
# OpenRouter:      clave gratis en https://openrouter.ai/keys (solo modelos :free)
# Mistral:         clave gratis en https://console.mistral.ai
GROQ_API_KEY=
# CEREBRAS_API_KEY=
GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=

# Modelos a usar (opcionales; por defecto el bot elige solo los mejores disponibles).
# Ojo: Groq pasó la familia llama (llama-3.3-70b-versatile) a plan Enterprise en
# agosto de 2026; lo que funciona en el plan gratuito son los GPT-OSS. Si fijás un
# modelo que tu clave no puede usar, el bot lo detecta y sigue con el respaldo.
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_MODEL=openai/gpt-oss-120b
# CEREBRAS_MODEL=llama-3.3-70b
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# MISTRAL_MODEL=mistral-small-latest

# Base de datos MariaDB/MySQL (la MISMA base de la web TriGGer.Arena).
# El bot crea y usa SOLO sus tablas con prefijo bot_ (bot_data, bot_stats,
# bot_cmd): nunca toca las tablas de la web. Si quedan vacías, el bot funciona
# solo con data/ local.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tu_name
DB_USER=tu_user
DB_PASSWORD=
