# Copia este archivo como ".env" y completa los valores.
# En Wispbyte: pestaña Startup -> Variables, o sube el .env (NUNCA lo subas a GitHub).

DISCORD_TOKEN=pegar_aqui_el_token_del_bot
CLIENT_ID=pegar_aqui_el_id_de_la_aplicacion
GUILD_ID=pegar_aqui_el_id_de_tu_servidor

# Opcional: chat con IA al mencionar al bot.
# Groq (principal): clave gratis en https://console.groq.com/keys
# Gemini (respaldo automático si Groq falla): clave gratis en https://aistudio.google.com/apikey
# Sin claves el bot igual funciona: usa sus respuestas de charla locales.
GEMINI_API_KEY=
GROQ_API_KEY=

# Modelos a usar (opcionales; por defecto el bot elige solo los mejores disponibles)
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# Base de datos Supabase (respaldo maestro de config, warns, niveles, afk e interacciones).
# 1. Creá el proyecto gratis en https://supabase.com (2 min, sin tarjeta).
# 2. SQL Editor → pegá sql/schema.sql → Run.
# 3. Project Settings → API: copiá la "Project URL" y la "service_role key" (¡la service_role,
#    no la anon!). Pegalas acá. Si quedan vacías, el bot funciona solo con data/ local.
SUPABASE_URL=
SUPABASE_KEY=
